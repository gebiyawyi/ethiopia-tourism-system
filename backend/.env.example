# ============================================
# 🌍 ETHIOPIA TOURISM - BACKEND ENVIRONMENT VARIABLES
# ============================================
# 
# 📌 INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace ALL placeholder values with your real credentials
# 3. NEVER commit .env to GitHub!
# 4. This .env.example file serves as a template for other developers
# ============================================

# ============================================
# 🚀 SERVER CONFIGURATION
# ============================================

# Port number for the server
PORT=5000

# Node environment: development, production, test
NODE_ENV=development

# API base URL
API_URL=http://localhost:5000/api

# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================

# MySQL Database Host (local or cloud)
DB_HOST=localhost

# MySQL Database Username
DB_USER=root

# MySQL Database Password - CHANGE THIS!
DB_PASSWORD=

# MySQL Database Name
DB_NAME=tourism_db

# MySQL Database Port (default: 3306)
DB_PORT=3306

# ============================================
# 🔐 JWT AUTHENTICATION
# ============================================

# JWT Secret Key - Generate a strong random string
# Run: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this

# JWT Token Expiration
JWT_EXPIRE=7d

# JWT Refresh Token Expiration
JWT_REFRESH_EXPIRE=30d

# ============================================
# ☁️ CLOUDINARY (Image Storage)
# ============================================

# Cloudinary Cloud Name - Get from cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Cloudinary API Key
CLOUDINARY_API_KEY=your_api_key_here

# Cloudinary API Secret - KEEP THIS SECRET!
CLOUDINARY_API_SECRET=your_api_secret_here

# Cloudinary Upload Folder
CLOUDINARY_FOLDER=ethiopia_tourism

# ============================================
# 🌐 FRONTEND URL (CORS)
# ============================================

# Frontend Development URL
FRONTEND_URL=http://localhost:5173

# Frontend Production URL (uncomment when deploying)
# FRONTEND_URL_PROD=https://your-frontend.netlify.app

# ============================================
# 👑 ADMIN CREDENTIALS
# ============================================

# Default Admin Email
ADMIN_EMAIL=admin@exploreethiopia.com

# Default Admin Password - CHANGE THIS!
ADMIN_PASSWORD=Admin@123456

# ============================================
# 🛡️ SECURITY & RATE LIMITING
# ============================================

# Rate Limiting - Window in minutes
RATE_LIMIT_WINDOW=15

# Rate Limiting - Max requests per window
RATE_LIMIT_MAX=100

# ============================================
# 📁 FILE UPLOAD LIMITS
# ============================================

# Maximum file size (5MB = 5 * 1024 * 1024)
MAX_FILE_SIZE=5242880

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ============================================
# 📧 EMAIL CONFIGURATION (Optional)
# ============================================

# Email Host (Gmail, SendGrid, etc.)
EMAIL_HOST=smtp.gmail.com

# Email Port
EMAIL_PORT=587

# Email Username
EMAIL_USER=your_email@gmail.com

# Email Password (App Password for Gmail)
EMAIL_PASSWORD=your_app_password_here

# Email From Address
EMAIL_FROM=noreply@exploreethiopia.com

# ============================================
# 💳 PAYMENT (Optional)
# ============================================

# Stripe Keys
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# PayPal Keys
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# ============================================
# 📌 DON'T FORGET!
# ============================================
# 1. Copy this file to .env
# 2. Replace ALL placeholder values with your real credentials
# 3. NEVER commit .env to GitHub
# 4. Keep .env.example in the repository for reference
# 5. Use strong passwords and secrets
# ============================================